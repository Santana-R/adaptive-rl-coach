PORT=3000
HOST=127.0.0.1

# Supabase (A08). Copiar a .env y rellenar; .env nunca se sube al repositorio.
# Panel de Supabase → Project Settings → API.
SUPABASE_URL=
# Clave privada del servidor (service_role o secret). Solo para Express; nunca en public/.
SUPABASE_SERVICE_ROLE_KEY=
# Clave pública (anon o publishable). La usa el navegador para iniciar sesión (A12)
# y el procedimiento de docs/prueba-auth.md para pedir tokens.
SUPABASE_ANON_KEY=

# Token privado de Ballchasing, solo para Express.
BALLCHASING_TOKEN=

# Límite total del formulario en MB.
REPLAY_UPLOAD_MAX_MB=100

# Caducidad en minutos para los archivos temporales.
REPLAY_TEMP_TTL_MINUTES=60

# Opcional: carpeta privada estable para reintentos tras reiniciar Node.
# Docker Compose fija /app/data/replays y la conserva en un volumen.
REPLAY_TEMP_DIR=
