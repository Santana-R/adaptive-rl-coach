PORT=3000
HOST=127.0.0.1

# Supabase (A08). Copiar a .env y rellenar; .env nunca se sube al repositorio.
# Panel de Supabase → Connect o Project Settings → API Keys.
SUPABASE_URL=
# Clave privada del servidor (service_role o secret). Solo para Express; nunca en public/.
SUPABASE_SERVICE_ROLE_KEY=
# Clave pública (anon o publishable) DEL MISMO proyecto. Express la entrega al navegador
# en /sitio/js/supabase-config.js. Nunca colocar aquí service_role ni una clave sb_secret_.
SUPABASE_ANON_KEY=

# Token privado de Ballchasing, solo para Express.
BALLCHASING_TOKEN=

# Límite total del formulario en MB.
REPLAY_UPLOAD_MAX_MB=100

# Caducidad en minutos para los archivos temporales.
REPLAY_TEMP_TTL_MINUTES=60

# Opcional: carpeta privada estable para reintentos tras reiniciar Node.
# Docker Compose fija /app/data/replays y la conserva en un volumen.
REPLAY_TEMP_DIR=

# La demostración sintética de análisis está desactivada por defecto.
# Solo habilitar localmente para una presentación con datos de ejemplo.
ANALYSIS_DEMO_ENABLED=false
